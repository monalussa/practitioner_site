[Unit]
Description=Gunicorn daemon for Conscious Parenting Coach website
After=network.target

[Service]
User=deploy
Group=www-data
WorkingDirectory=/home/deploy/personal-service-web
EnvironmentFile=/home/deploy/personal-service-web/.env
ExecStart=/home/deploy/personal-service-web/.venv/bin/gunicorn \
    --workers 3 \
    --bind 127.0.0.1:8000 \
    --access-logfile /var/log/gunicorn/access.log \
    --error-logfile /var/log/gunicorn/error.log \
    config.wsgi:application
Restart=on-failure

[Install]
WantedBy=multi-user.target
