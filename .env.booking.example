# Easy!Appointments environment — copy to .env.booking (dev) or .env.booking.prod (production)
# NEVER commit the real .env.booking files — they are gitignored.

# ── EA PHP container ────────────────────────────────────────────────────────
# URL where Easy!Appointments will be accessible (include trailing slash)
BASE_URL=http://localhost:9090/
# Set to "true" in development only
EA_DEBUG=false
# Must match the MySQL settings below
DB_HOST=db
DB_NAME=easyappointments
DB_USERNAME=ea_user
DB_PASSWORD=change_me

# ── MySQL container ─────────────────────────────────────────────────────────
# These must match DB_NAME / DB_USERNAME / DB_PASSWORD above
MYSQL_DATABASE=easyappointments
MYSQL_USER=ea_user
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root
